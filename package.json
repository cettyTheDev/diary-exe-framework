{
  "name": "diary-exe-framework",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/heycetty/diary-exe-framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/heycetty/diary-exe-framework.git"
  },
  "bugs": {
    "url": "https://github.com/heycetty/diary-exe-framework/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "intake:gate": "node --experimental-strip-types scripts/intake-gate-report.ts",
    "intake:dry-run": "node --experimental-strip-types scripts/intake-dry-run.ts",
    "m2:vault-demo": "node --experimental-strip-types scripts/vault-fixture-demo.ts",
    "m2:fixture-pipeline": "node --experimental-strip-types scripts/m2-fixture-pipeline.ts",
    "review:workbench": "node --experimental-strip-types scripts/private-review-workbench.ts",
    "quality:report": "node --experimental-strip-types scripts/quality-report.ts",
    "public:check": "node --test --experimental-strip-types tests/public-boundary.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  }
}
